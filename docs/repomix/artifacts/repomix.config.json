  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      ".agents/**",
      ".claude/**",
      ".codex/**",
      "assets/**",
      "docs/**",
      "tools/**",
      "**/.env",
      "**/.env.*",
      "**/*.key",
      "**/*.keystore"
    ]
  },
  "output": {
    "style": "xml",
    "parsableStyle": true,
    "filePathStyle": "target-relative",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "truncateBase64": false,
    "copyToClipboard": false,
    "includeFullDirectoryStructure": false,
    "git": {
      "sortByChanges": false,
      "includeDiffs": false,
      "includeLogs": false
    },
    "headerText": "Focused JFTP connection and transfer workflow. Full selected files with original comments; not the complete application or a transitive dependency closure."
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
